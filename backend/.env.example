# Copie este arquivo para .env e preencha. O .env não vai para o GitHub.

PORT=3333

# Supabase: Project Settings > API (ou a saída de `npx supabase start` no ambiente local)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=
# Chave secreta: só no back-end, nunca no front-end nem no GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# Origens do front-end liberadas no CORS, separadas por vírgula.
CORS_ORIGIN=http://localhost:5173

# Usuários de teste criados por `npm run criar-usuarios`.
# Use senhas próprias e não reutilize senhas pessoais.
SEED_GERENTE_EMAIL=gerente@sgpet.test
SEED_GERENTE_SENHA=
SEED_GERENTE_NOME=Gerente Teste
SEED_ATENDENTE_EMAIL=atendente@sgpet.test
SEED_ATENDENTE_SENHA=
SEED_ATENDENTE_NOME=Atendente Teste
