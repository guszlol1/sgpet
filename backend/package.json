{
  "name": "sgpet-backend",
  "version": "0.1.0",
  "description": "API do SGPet - Sistema de Gestão Pet UFSCar",
  "private": true,
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "criar-usuarios": "node scripts/criar-usuarios.js",
    "test:unit": "jest --runInBand tests/unit",
    "test:integration": "jest --runInBand tests/integration",
    "test:coverage": "jest --runInBand --coverage",
    "test:db": "node --test --test-concurrency=1 tests/database/*.test.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "jest": "^30.5.2"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "collectCoverageFrom": [
      "src/modules/**/*.js",
      "src/middlewares/**/*.js",
      "src/shared/**/*.js",
      "src/app.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/database/"
    ]
  }
}
